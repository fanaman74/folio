{
  "name": "folio-converter",
  "version": "1.0.0",
  "private": true,
  "description": "A private-by-default file and folder converter for Railway.",
  "scripts": {
    "dev": "concurrently -k -n api,web \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:browser": "playwright test",
    "test:deployment": "node tests/deployment-smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "archiver": "^8.0.0",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.53.0",
    "multer": "^2.4.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "ffmpeg-static": "^5.3.0",
    "jszip": "^3.10.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
